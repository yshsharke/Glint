{
  "name": "glint",
  "productName": "Glint",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "author": "Glint contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yshsharke/Glint.git"
  },
  "homepage": "https://github.com/yshsharke/Glint#readme",
  "bugs": {
    "url": "https://github.com/yshsharke/Glint/issues"
  },
  "engines": {
    "node": "24.x"
  },
  "description": "A small, customizable selection assistant for Windows.",
  "main": "dist/main.cjs",
  "scripts": {
    "setup:electron": "node node_modules/electron/install.js",
    "build": "node scripts/build.mjs",
    "start": "npm run build && node scripts/launch.mjs",
    "dev": "npm start",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "smoke": "npm run build && node scripts/launch.mjs --smoke",
    "package": "npm run build && electron-builder --win --x64 --publish never && node scripts/checksums.mjs",
    "package:verify": "node scripts/verify-package.mjs",
    "package:verify-installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-installer.ps1",
    "smoke:packaged": "node scripts/verify-package.mjs --smoke"
  },
  "dependencies": {
    "selection-hook": "2.1.1"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@fluentui/react-components": "9.74.7",
    "@fluentui/react-motion": "9.16.3",
    "@fluentui/react-motion-components-preview": "0.15.8",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "44.4.2",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "lucide-static": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
